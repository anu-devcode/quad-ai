DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com,https://quad-ai-brown.vercel.app
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com,https://quad-ai-brown.vercel.app
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_SSL_REDIRECT=false
DATABASE_URL=postgres://campus:campus-password@db:5432/campus
FRAUD_MODEL_API_URL=http://fastapi:8001/predict
FRAUD_MODEL_API_TIMEOUT_SECONDS=8
POSTGRES_DB=campus
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus-password

# If frontend is served by the same Nginx container, keep /api.
# If frontend is on Vercel, set this to your public backend API base.
VITE_API_BASE_URL=/api
# VITE_API_BASE_URL=https://api.example.com/api