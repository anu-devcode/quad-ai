FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Tesseract + OpenCV runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.django.docker.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY campus/ /app/campus/
COPY docker/ /app/docker/

RUN sed -i 's/\r$//' /app/docker/entrypoint.django.sh \
    && chmod +x /app/docker/entrypoint.django.sh

EXPOSE 8000

ENTRYPOINT ["/app/docker/entrypoint.django.sh"]
CMD ["gunicorn", "--chdir", "campus", "campus.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "120"]
